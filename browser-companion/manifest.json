{
  "manifest_version": 3,
  "name": "C2C Browser Companion",
  "version": "0.1.1",
  "description": "轻量 ChatGPT 网页伴侣：连接、DOM 操作与结果观察由 Bridge 统一调度。",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "bridge-client.js",
    "type": "module"
  },
  "action": {
    "default_title": "C2C Companion",
    "default_popup": "popup/lightweight.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*"
      ],
      "js": [
        "route-global.js",
        "dom-adapter-global.js",
        "turn-observer-global.js",
        "composer-write-adapter.js",
        "send-click-adapter.js",
        "content-lite.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
