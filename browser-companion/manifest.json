{
  "manifest_version": 3,
  "name": "C2C Browser Companion",
  "version": "0.2.0",
  "description": "把 Codex 执行结果回传到已连接的 ChatGPT 对话。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "C2C Companion", "default_popup": "popup/popup.html" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://www.chatgpt.com/*"],
      "js": [
        "dom-adapter-global.js",
        "turn-observer-global.js",
        "composer-write-adapter.js",
        "send-click-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
